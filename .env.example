# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Transformadora de Empaques · Inventory App
#
# Copiá este archivo a .env y completá los valores.
# En Portainer: configurá cada variable en Environment → Add environment variable.
# NUNCA subas .env al repositorio.
# ─────────────────────────────────────────────────────────────────────────────

# Django
# Generá una clave segura con: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# False en producción. True solo para debug local.
DEBUG=False

# IPs y dominios que Django acepta, separados por coma, sin espacios.
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.0.62,inventario.tempaques.com

# Orígenes CSRF permitidos (esquema completo, sin barra final, separados por coma).
CSRF_TRUSTED_ORIGINS=https://inventario.tempaques.com

# Base de datos PostgreSQL
DB_NAME=bolsas_inventario
DB_USER=bolsas_user
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432

# Backups PostgreSQL (automáticos + manuales desde el panel)
# En Raspberry/Portainer usa una ruta absoluta persistente.
# Ejemplo: /apps/inventario/backups
POSTGRES_HOST=db
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
BACKUP_TIMEOUT_SECONDS=300

# Hora del backup automático diario (lo ejecuta el worker de Celery).
BACKUP_SCHEDULE_HOUR=2
BACKUP_SCHEDULE_MINUTE=30

# IMPORTANTE — copia fuera del host.
# BACKUP_DIR vive en el MISMO disco que la base de datos: si se pierde el
# equipo, se pierden la base y todos sus respaldos a la vez. Este hook es un
# script (dentro del contenedor worker) que recibe la ruta del .sql.gz recién
# creado y lo copia a otro lado (rclone/S3, rsync a otra máquina, etc.).
# Si falla, el backup local igual queda hecho y verificado.
# Ejemplo: BACKUP_POST_HOOK=/scripts/subir_backup.sh
BACKUP_POST_HOOK=
BACKUP_HOOK_TIMEOUT_SECONDS=600

# Segundos que se reutiliza cada conexión a Postgres (0 = una nueva por request).
CONN_MAX_AGE=60

# Puerto expuesto en el host (Cloudflare Tunnel apunta a este puerto).
APP_PORT=8000

# Webhook de n8n para alertas de stock. Dejar vacío para deshabilitar.
N8N_WEBHOOK_URL=

# Web Push (generar una sola vez y conservar las claves entre despliegues).
# VAPID_SUBJECT debe ser mailto:correo@dominio.com o una URL https.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@tempaques.com

# Token compartido para ingesta automática de PDFs de facturas/envíos.
# n8n debe enviarlo como header: X-API-Key
FACTURAS_INGEST_TOKEN=

# Redis (caché compartida entre workers de gunicorn). Imprescindible para que
# el anti-spam de alertas de stock no se duplique con varios workers.
# En docker-compose ya hay un servicio "redis"; dejar este valor por defecto.
# Vacío → usa caché en memoria por proceso (solo válido en local/1 worker).
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# URL del panel de administración (sin / inicial, con / final).
# Ejemplo: mi-panel-admin-XYZ/   → acceso en https://dominio.com/mi-panel-admin-XYZ/
# Por defecto: gestion-interna/  ← cámbiala en producción.
ADMIN_URL=gestion-interna/
